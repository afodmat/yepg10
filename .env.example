# Copy to .env and fill in. Never commit .env.
# Supabase session pooler; recommended on networks without IPv6 support.
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<project-ref>
# DB_USERNAME is also accepted if that is the variable your environment already uses.
DB_PASSWORD=your-supabase-password
# >= 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=
COOKIE_SECURE=false          # true in production (HTTPS)
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8080
SPRING_PROFILES_ACTIVE=dev   # 'dev' enables demo accounts + debug logging
YEP_DEV_SEED_PASSWORD=  password123     # password for demo accounts (dev only)
FORWARD_HEADERS_STRATEGY=none  # set to native when running behind a trusted reverse proxy (needed for per-client rate limiting)
STORAGE_PATH=./uploads       # where uploaded files are stored (swap StorageService for S3 later)
